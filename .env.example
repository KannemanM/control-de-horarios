# Copiá este archivo a .env y completá los valores antes de arrancar.
# En producción usá claves largas y aleatorias. No subas .env a Git.
# Evitá #, $, @, : y / en las claves para no romper Compose ni la URL de la base.

# PostgreSQL del servicio `db` de Docker Compose.
POSTGRES_DB=control_horarios
POSTGRES_USER=control
POSTGRES_PASSWORD=cambia-esta-clave-por-una-larga

# Para desarrollo local con PostgreSQL en localhost.
# Dentro de Docker Compose la app usa automáticamente el host `db`.
DATABASE_URL="postgresql://control:cambia-esta-clave-por-una-larga@localhost:5432/control_horarios?schema=public"

# Firma de las cookies de sesión. Tiene que quedar fija entre reinicios.
AUTH_SECRET="cambia-esta-clave-por-una-aleatoria-muy-larga"

# Solo se usa la primera vez, cuando todavía no existe ningún usuario.
# Después se puede cambiar desde el panel.
ADMIN_PASSWORD="cambia-esta-clave-inicial"
