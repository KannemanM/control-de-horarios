generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoTurno {
  ORDINARIO
  EXTRA
}

model Usuario {
  id           Int      @id @default(autoincrement())
  passwordHash String
  createdAt    DateTime @default(now())
}

model Operario {
  id        Int      @id @default(autoincrement())
  nombre    String
  createdAt DateTime @default(now())
  turnos    Turno[]

  @@index([nombre])
}

model Turno {
  id         Int      @id @default(autoincrement())
  operarioId Int
  operario   Operario @relation(fields: [operarioId], references: [id], onDelete: Cascade)
  fecha      DateTime
  tipo       TipoTurno @default(ORDINARIO)
  secuencia  Int?      @default(1)
  entrada    DateTime?
  salida     DateTime?
  horasExtras Int?     // minutos, solo para tipo EXTRA
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([fecha])
  @@index([operarioId, fecha])
}
