generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           Int      @id @default(autoincrement())
  passwordHash String
  createdAt    DateTime @default(now())
}

model Operario {
  id        Int      @id @default(autoincrement())
  nombre    String
  createdAt DateTime @default(now())
  turnos    Turno[]

  @@index([nombre])
}

model Turno {
  id         Int      @id @default(autoincrement())
  operarioId Int
  operario   Operario @relation(fields: [operarioId], references: [id], onDelete: Cascade)
  fecha      DateTime
  entrada    DateTime
  salida     DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([operarioId, fecha])
  @@index([fecha])
}
